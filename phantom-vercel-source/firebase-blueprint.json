{
  "entities": {
    "Room": {
      "title": "Room",
      "description": "An ephemeral chat room session with zero identity requirements",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[A-Z0-9_-]+$",
          "description": "The unique uppercase alphanumeric room code"
        },
        "creatorId": {
          "type": "string",
          "maxLength": 128,
          "description": "Anonymous user ID of the room creator"
        },
        "createdAt": {
          "type": "number",
          "description": "Timestamp when room was created in epoch milliseconds"
        },
        "lastActive": {
          "type": "number",
          "description": "Timestamp of most recent activity in epoch milliseconds"
        },
        "expiresAt": {
          "type": "number",
          "description": "TTL timestamp when the room and messages should be deleted"
        }
      },
      "required": ["code", "createdAt", "lastActive", "expiresAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A single ephemeral chat message within a room",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique identifier of the message"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Anonymous user identifier"
        },
        "nickname": {
          "type": "string",
          "maxLength": 32,
          "description": "Display name of the author"
        },
        "avatarColor": {
          "type": "string",
          "maxLength": 32,
          "description": "Theme color token for the user avatar"
        },
        "text": {
          "type": "string",
          "maxLength": 2000,
          "description": "Body content of the message"
        },
        "timestamp": {
          "type": "number",
          "description": "Creation timestamp in epoch milliseconds"
        },
        "type": {
          "type": "string",
          "enum": ["text", "image", "sticker", "system"],
          "description": "Type of message payload"
        },
        "mediaUrl": {
          "type": "string",
          "maxLength": 500000,
          "description": "Optional inline data URI or sticker asset URL"
        },
        "status": {
          "type": "string",
          "enum": ["sent", "delivered", "seen"],
          "description": "Delivery status of the message"
        },
        "reactions": {
          "type": "object",
          "description": "Map of emoji reactions to user IDs"
        },
        "expiresAt": {
          "type": "number",
          "description": "Auto-expiration timestamp for temporary cleanup"
        }
      },
      "required": ["id", "userId", "nickname", "text", "timestamp", "type"]
    },
    "Participant": {
      "title": "Participant",
      "description": "Active participant in a room for real-time presence",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique temporary user ID"
        },
        "nickname": {
          "type": "string",
          "maxLength": 32,
          "description": "User chosen or anonymous name"
        },
        "avatarColor": {
          "type": "string",
          "maxLength": 32,
          "description": "Assigned liquid palette color"
        },
        "avatarSeed": {
          "type": "string",
          "maxLength": 32,
          "description": "Random seed for the avatar icon"
        },
        "lastSeen": {
          "type": "number",
          "description": "Epoch timestamp of last heartbeat"
        },
        "isTyping": {
          "type": "boolean",
          "description": "Whether the user is currently typing"
        }
      },
      "required": ["userId", "nickname", "avatarColor", "lastSeen"]
    },
    "Pulse": {
      "title": "Pulse",
      "description": "A liquid ripple pulse wave broadcasted across the room",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "description": "Unique wave ID"
        },
        "fromUser": {
          "type": "string",
          "maxLength": 32,
          "description": "Nickname of user who emitted the wave"
        },
        "senderColor": {
          "type": "string",
          "maxLength": 32,
          "description": "Color tone of the pulse"
        },
        "timestamp": {
          "type": "number",
          "description": "Timestamp when pulse was sent"
        }
      },
      "required": ["id", "fromUser", "timestamp"]
    }
  },
  "firestore": {
    "/rooms/{roomId}": {
      "schema": "Room",
      "description": "Top-level ephemeral room documents keyed by uppercase room code"
    },
    "/rooms/{roomId}/messages/{messageId}": {
      "schema": "Message",
      "description": "Subcollection of messages inside a specific room"
    },
    "/rooms/{roomId}/participants/{participantId}": {
      "schema": "Participant",
      "description": "Subcollection of active participants inside a specific room"
    },
    "/rooms/{roomId}/pulses/{pulseId}": {
      "schema": "Pulse",
      "description": "Ephemeral pulse ripple waves triggered in the room"
    }
  }
}
