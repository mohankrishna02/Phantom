rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidRoom(data) {
      return data.code is string &&
             data.code.size() >= 3 &&
             data.code.size() <= 64 &&
             data.createdAt is number &&
             data.lastActive is number &&
             data.expiresAt is number &&
             (!('creatorId' in data) || (data.creatorId is string && data.creatorId.size() <= 128));
    }

    function isValidMessage(data) {
      return data.id is string && data.id.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 &&
             data.nickname is string && data.nickname.size() <= 32 &&
             data.text is string && data.text.size() <= 2000 &&
             data.timestamp is number &&
             (data.type == 'chat' || data.type == 'text' || data.type == 'image' || data.type == 'sticker' || data.type == 'system');
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Ephemeral Rooms
    match /rooms/{roomId} {
      allow get: if isValidId(roomId);
      allow list: if false;
      allow create: if isValidId(roomId) && isValidRoom(incoming());
      allow update: if isValidId(roomId) && isValidRoom(incoming());
      allow delete: if isValidId(roomId);

      // Messages in room
      match /messages/{messageId} {
        allow read: if isValidId(roomId);
        allow create: if isValidId(roomId) && isValidId(messageId) && isValidMessage(incoming());
        allow update: if isValidId(roomId) && isValidId(messageId) &&
                         incoming().userId == existing().userId &&
                         incoming().timestamp == existing().timestamp;
        allow delete: if isValidId(roomId) && isValidId(messageId);
      }

      // Active Participants
      match /participants/{participantId} {
        allow read: if isValidId(roomId);
        allow write: if isValidId(roomId) && isValidId(participantId);
      }

      // Ripple Pulses
      match /pulses/{pulseId} {
        allow read: if isValidId(roomId);
        allow create: if isValidId(roomId) && isValidId(pulseId);
        allow delete: if isValidId(roomId);
      }
    }
  }
}
